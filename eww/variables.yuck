;;;;;;;;;;;;;;;
;; VARIABLES ;;
;;;;;;;;;;;;;;;

(deflisten workspace "~/.config/eww/scripts/workspace")

;; Profile Variables
(defpoll NAME  :interval "5m" "hostname")
(defpoll UNAME :interval "5m" "whoami")

;; Systray Variables
(defpoll ram-usage          :interval "1s" "~/.config/eww/dashboard/scripts/sys_info --mem")
(defpoll battery-capacity   :interval "1s" "~/.config/eww/dashboard/scripts/sys_info --bat")
(defpoll current-brightness :interval "1s" "~/.config/eww/dashboard/scripts/sys_info --bri")
(defpoll current-volume     :interval "1s" "~/.config/eww/dashboard/scripts/sys_info --vol")

;; Memory Variables
(defpoll memory          :interval "15s" "~/.config/eww/scripts/memory")
(defpoll memory_used_mb  :interval "2m" "~/.config/eww/scripts/mem-ad used")
(defpoll memory_total_mb :interval "2m" "~/.config/eww/scripts/mem-ad total")
(defpoll memory_free_mb  :interval "2m" "~/.config/eww/scripts/mem-ad free")

;; Battery Variables
(defpoll battery        :interval "15s" "~/.config/eww/scripts/battery --bat")
(defpoll battery_status :interval "10s" "~/.config/eww/scripts/battery --bat-st")

;; Time Variables
(defpoll clock_hour    :interval "5m" "date +\%H")
(defpoll clock_minute  :interval "0.5s" "date +\%M")
(defpoll clock_date    :interval "10h" "date '+%d/%m'")
(defpoll calendar_day  :interval "20h" "date '+%d'")
(defpoll calendar_year :interval "20h" "date '+%Y'")

;; Wifi Variables
(defpoll COL_WLAN   :interval "1m" "~/.config/eww/scripts/wifi --COL")
(defpoll ESSID_WLAN :interval "1m" "~/.config/eww/scripts/wifi --ESSID")
(defpoll WLAN_ICON  :interval "1m" "~/.config/eww/scripts/wifi --ICON")

;; Brightness Variables
(defpoll brightness_percent :interval "1s" "~/.config/eww/scripts/brightness --BRIGHT")
(defpoll brightness_icon    :interval "1s" "~/.config/eww/scripts/brightness --ICON")

;; Volume Variables
(defpoll mic_percent    :interval "3s" "amixer -D pulse sget Capture | grep 'Left:' | awk -F'[][]' '{ print $2 }' | tr -d '%'")
(defpoll volume_percent :interval "1s" "~/.config/eww/scripts/audio --VOL")
(defpoll volume_icon    :interval "1s" "~/.config/eww/scripts/audio --ICON")
(defpoll volume_col     :interval "1s" "~/.config/eww/scripts/audio --COL")

;; Music Variables
(defpoll song           :interval "2s" "~/.config/eww/scripts/music_info --song")
(defpoll song_artist    :interval "2s" "~/.config/eww/scripts/music_info --artist")
(defpoll current_status :interval "1s" "~/.config/eww/scripts/music_info --time")
(defpoll song_status    :interval "2s" "~/.config/eww/scripts/music_info --status")
(defpoll cover_art      :interval "2s" "~/.config/eww/scripts/music_info --cover")

;; Quotes Variables
(defpoll quote_text   :interval "10m" "~/.config/eww/dashboard/scripts/quotes quote")
(defpoll quote_author :interval "10m" "~/.config/eww/dashboard/scripts/quotes author")

;; Weather Variables
(defpoll weather-icon    :interval "10m" "~/.config/eww/dashboard/scripts/getweather --icon")
(defpoll weather-city    :interval "10m" "~/.config/eww/dashboard/scripts/getweather --city")
(defpoll weather-country :interval "10m" "~/.config/eww/dashboard/scripts/getweather --country")
(defpoll weather-hex     :interval "10m" "~/.config/eww/dashboard/scripts/getweather --hex")
(defpoll temperature     :interval "10m" "~/.config/eww/dashboard/scripts/getweather --temp")
(defpoll weather-stat    :interval "10m" "~/.config/eww/dashboard/scripts/getweather --stat")

;; Task Variables
(defpoll uptime     :interval "60s" "~/.config/eww/dashboard/scripts/task up")
(defpoll cpuavg     :interval "60s" "~/.config/eww/dashboard/scripts/task cpuavg")
(defpoll disk-usage :interval "1h" "~/.config/eww/dashboard/scripts/task disk")
(defpoll mem-usage  :interval "30s" "~/.config/eww/dashboard/scripts/task mem")

;; Revealers
(defvar vol_reveal      false)
(defvar br_reveal       false)
(defvar music_reveal    false)
(defvar wifi_rev        false)
(defvar time_rev        false)
(defvar shutdown_reveal false)
(defvar barhover        false)
(defvar menuhover       false)

